# NutriMess Backend Environment Variables
SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key; used as `apikey` header (user JWTs enforce RLS)
SUPABASE_ANON_KEY=
# Optional, only needed for admin/background jobs
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:3000
# Optional regex for preview deployments (Azure SWA PR environments)
CORS_ORIGIN_REGEX=
# Gemini calls per user per window (menu extract, plate scan, AI chat)
AI_REQUESTS_PER_WINDOW=30
AI_WINDOW_SECONDS=600
DEBUG=false
