# NutriMess Backend Environment Variables
SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key; used as `apikey` header (user JWTs enforce RLS)
SUPABASE_ANON_KEY=
# Optional, only needed for admin/background jobs
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:3000
DEBUG=false
